# Application Configuration
APP_NAME=conversational-intelligence
APP_ENV=development
LOG_LEVEL=INFO

# Audio Configuration
SUPPORTED_AUDIO_FORMATS=wav,mp3,m4a,flac
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# VAD Configuration
VAD_ENABLED=true
VAD_MODEL=silero_vad

# ASR Configuration
ASR_MODEL=base
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=en
ASR_MODEL_CACHE_DIR=

# Diarization Configuration
DIARIZATION_ENABLED=true
DIARIZATION_MODEL=pyannote/speaker-diarization-3.0
DIARIZATION_DEVICE=cpu
DIARIZATION_MODEL_CACHE_DIR=

# Insight Processing
PARAMETERS_PER_BATCH=3
PARALLEL_WORKERS=1

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
GROQ_TIMEOUT=30.0
GROQ_MAX_RETRIES=3
GROQ_RETRY_BACKOFF=2.0

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=conversational_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Storage Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=
MINIO_BUCKET=audio-processing

# Storage Prefixes
RAW_AUDIO_PREFIX=raw/
PROCESSED_AUDIO_PREFIX=processed/
TRANSCRIPT_PREFIX=transcripts/
DIARIZED_PREFIX=diarized/
INSIGHTS_PREFIX=insights/
